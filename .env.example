# THE MACHINE — environment secrets template.
# Copy to `.env` and fill in. NEVER commit the real .env (already gitignored).
# All values are OPTIONAL: with none set, the system runs fully local/offline
# (vision works; AI Core falls back to deterministic command answers).

# --- Cloud / API LLM (OpenAI-compatible) -------------------------------
# Leave empty to disable cloud AI entirely (privacy default).
AI_PROVIDER=none              # none | openai_compat | ollama
AI_API_KEY=                   # e.g. sk-...   (never hardcode elsewhere)
AI_BASE_URL=                  # e.g. https://api.openai.com/v1 or http://localhost:11434/v1
AI_MODEL=                     # e.g. gpt-4o-mini / qwen2.5:7b

# --- Local Ollama (alternative to cloud) --------------------------------
OLLAMA_HOST=http://localhost:11434

# Note: structured text context only is sent to any provider by default.
# Raw camera frames are NEVER uploaded unless explicitly configured AND asked.
