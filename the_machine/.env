# THE MACHINE — environment secrets template.
# Copy to `.env` and fill in. NEVER commit the real .env (already gitignored).
# All values are OPTIONAL: with none set, the system runs fully local/offline
# (vision works; AI Core falls back to deterministic command answers).

# --- Cloud / API LLM (OpenAI-compatible) -------------------------------
# Leave empty to disable cloud AI entirely (privacy default).
AI_PROVIDER=nvidia
AI_API_KEY=k
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# >>> FREE OPTION 1: NVIDIA NIM (recommended free cloud, no GPU needed)
#     1) https://build.nvidia.com -> sign in (free NVIDIA account)
#     2) pick any model -> "Get API Key" -> copy the nvapi-... key
#     3) set these four lines:
# AI_PROVIDER=nvidia            # (or openai_compat — same thing)
# AI_API_KEY=nvapi-XXXXXXXXXXXX
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
#     other free models on the same endpoint, e.g.:
#       meta/llama-3.1-8b-instruct | microsoft/phi-4 | qwen/qwen2.5-7b-instruct

# >>> FREE OPTION 2: OpenRouter (many free models, one key)
# AI_PROVIDER=openai_compat
# AI_API_KEY=sk-or-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# >>> LOCAL OPTION: Ollama (needs your own hardware)
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2

# Note: structured text context only is sent to any provider by default.
# Raw camera frames are NEVER uploaded unless explicitly configured AND asked.
